/**
 * Implements hook_page_attachments().
 */
function dhcr_backend_page_attachments(array &$attachments): void {
  $route_name = \Drupal::routeMatch()->getRouteName() ?? '';

  if (
    str_starts_with($route_name, 'dhcr_backend.') ||
    str_starts_with($route_name, 'entity.dhcr_')
  ) {
    $attachments['#attached']['library'][] = 'dhcr_backend/admin_base';
    $attachments['#attached']['library'][] = 'dhcr_backend/fontawesome_free';
    $attachments['#attached']['library'][] = 'dhcr_backend/admin_table_search';
  }
}

/**
 * Implements hook_form_alter().
 */
function dhcr_backend_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $route_name = \Drupal::routeMatch()->getRouteName() ?? '';

  if (
    str_starts_with($route_name, 'dhcr_backend.') ||
    str_starts_with($route_name, 'entity.dhcr_')
  ) {
    $form['#attributes']['class'][] = 'dhcr-backend-form';
  }
}

/**
 * Implements hook_mail().
 */
function dhcr_backend_mail(string $key, array &$message, array $params): void {
  if ($key !== 'template') {
    return;
  }

  $message['subject'] = (string) ($params['subject'] ?? '');
  $message['body'][] = (string) ($params['body'] ?? '');

  $from = trim((string) ($params['from'] ?? ''));
  if ($from !== '') {
    $message['from'] = $from;
    $message['headers']['From'] = $from;
  }
  if (!empty($params['cc'])) {
    $message['headers']['Cc'] = implode(', ', (array) $params['cc']);
  }
  if (!empty($params['bcc'])) {
    $message['headers']['Bcc'] = implode(', ', (array) $params['bcc']);
  }
}
